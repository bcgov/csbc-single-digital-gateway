    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.27",
    "@nestjs/platform-express": "11.1.27",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/terminus": "11.1.1",
    "@repo/database": "*",
    "@repo/nestjs": "*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "connect-redis": "^8.1.0",
    "drizzle-orm": "^0.45.2",
    "express-session": "^1.19.0",
    "iovalkey": "^0.3.3",
    "nestjs-zod": "^5.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.23",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.27",
    "@swc/cli": "0.8.1",
