# citizen-portal-api environment
# Copy to .env (gitignored). Validated by zod at boot — see src/config/env.schema.ts.
#
# Local-dev defaults against the root compose.yml stack (Postgres + Valkey + Keycloak with the
# committed keycloak/citizens-realm.json). NOT secrets — replace for any non-local environment.

# Node environment: development | production | test
NODE_ENV=development

# HTTP port the server listens on
PORT=4000

# pino log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# --- Database (required, no default) -----------------------------------------------------------
# Shared with platform-api (same @repo/database). Matches compose.yml (postgres/postgres/sdg).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sdg

# --- OIDC / BFF (required, no default) ----------------------------------------------------------
# Separate "citizens" Keycloak realm + confidential client (see keycloak/citizens-realm.json).
OIDC_ISSUER=http://localhost:8080/realms/citizens
OIDC_CLIENT_ID=citizen-portal-api
OIDC_CLIENT_SECRET=test-secret
OIDC_REDIRECT_URI=http://localhost:4000/auth/callback
# Session cookie signing secret (min 16 chars). Use a long random value in production.
AUTH_SESSION_SECRET=dev-citizen-session-secret-change-me
# Where the app sends the browser after a successful login — the citizen-portal-web home (:3000),
# which is auth-aware (there is no separate /app page).
AUTH_POST_LOGIN_REDIRECT=http://localhost:3000/
# Baseline role for a new citizen (citizen-portal-api may only stamp `citizen`).
AUTH_DEFAULT_ROLE=citizen
# Valkey key prefix — MUST differ from platform-api's (sdg:) so sessions don't collide.
SESSION_KEY_PREFIX=cpa:

# --- Logout hardening ---------------------------------------------------------------------------
AUTH_RP_LOGOUT=false
# AUTH_POST_LOGOUT_REDIRECT=http://localhost:3000/

# --- Token refresh ------------------------------------------------------------------------------
# Refresh the access token this many seconds before it expires (lazy, on-request). Default 30.
AUTH_TOKEN_REFRESH_SKEW_SECONDS=30
# Clock drift tolerated on JWT timestamp claims. Unset = openid-client's built-in 30s.
# Raise it only if the IdP and this BFF genuinely disagree by more than that (fix NTP first).
# AUTH_CLOCK_TOLERANCE_SECONDS=60

# --- CSRF -------------------------------------------------------------------------------------
# CSRF Origin allowlist (comma-separated) for mutating requests. citizen-portal-web runs on :3000.
AUTH_ALLOWED_ORIGINS=http://localhost:3000

# --- Session store ------------------------------------------------------------------------------
# Valkey (Redis wire protocol); shared instance, isolated by SESSION_KEY_PREFIX.
VALKEY_URL=redis://localhost:6380

# --- Outbox relay → notification-service --------------------------------------------------------
# Drains notification_outbox rows to the notification-service ingestion API using this app's
# m2m service-account client in the sdg realm (NOT the login realm/client).
NOTIFICATION_SERVICE_URL=http://localhost:4002
NOTIFICATIONS_M2M_ISSUER=http://localhost:8080/realms/sdg
NOTIFICATIONS_M2M_CLIENT_ID=citizen-portal-api-m2m
NOTIFICATIONS_M2M_CLIENT_SECRET=test-secret
OUTBOX_RELAY_ENABLED=true
OUTBOX_RELAY_INTERVAL_MS=5000
OUTBOX_RELAY_BATCH_SIZE=10
OUTBOX_RELAY_MAX_ATTEMPTS=5

# --- Notification email links -------------------------------------------------------------------
# Public web origins the notification emails deep-link into (composed server-side from config).
CITIZEN_WEB_URL=http://localhost:3000
PLATFORM_WEB_URL=http://localhost:3001

# --- Address geocoder (feature 154) -------------------------------------------------------------
# BC OLS Physical Address Geocoder. Leave the key unset to disable the "Search for your address"
# field (the CA/BC region is only registered when a key is present). Obtain a key from the BC API
# portal (https://api.gov.bc.ca/devportal/api-directory). Secret — server-side only.
BC_GEOCODER_URL=https://geocoder.api.gov.bc.ca
# BC_GEOCODER_API_KEY=
