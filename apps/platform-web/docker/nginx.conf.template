# SPA static server + BFF reverse-proxy for platform-web. Runs inside nginxinc/nginx-unprivileged,
# which listens on 8080 as a non-root user (OpenShift/K8s friendly). Rendered from this template at
# container start by the image's 20-envsubst-on-templates.sh entrypoint — only ${API_UPSTREAM} is
# substituted (NGINX_ENVSUBST_FILTER=API_UPSTREAM scopes envsubst to that one var, so nginx runtime
# variables like $uri / $host survive). Replaces the image's default.conf.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml application/wasm;

    # BFF reverse-proxy: /api/* → the platform-api Service, SAME-ORIGIN with the SPA. The trailing
    # slash on proxy_pass strips the /api prefix, so the BFF sees /v1, /auth, /health at its root.
    # X-Forwarded-Proto is asserted https (the external hop is always edge-TLS via the Route), so the
    # BFF issues Secure cookies and builds correct origins.
    location /api/ {
        proxy_pass http://${API_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_read_timeout 60s;
    }

    # Content-hashed build assets — safe to cache forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # App shell + runtime config change per deploy/env — never cache. Unknown paths fall back
    # to the SPA shell for client-side (TanStack) routing.
    location / {
        add_header Cache-Control "no-store";
        try_files $uri /index.html;
    }
}
