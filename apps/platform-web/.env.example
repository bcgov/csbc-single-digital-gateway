# platform-web environment (Vite). Copy to .env (gitignored). Only VITE_*-prefixed vars are
# exposed to the browser bundle, so never put secrets here.

# Origin of this app's BFF (platform-api). Defaults to http://localhost:4001 when unset; set to
# the real API origin in other environments.
VITE_BFF_ORIGIN=http://localhost:4001
