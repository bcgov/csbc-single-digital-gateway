# platform-api environment
# Copy to .env (gitignored). Validated by zod at boot — see src/config/env.schema.ts.

# Node environment: development | production | test
NODE_ENV=development

# HTTP port the server listens on
PORT=4001

# RP-initiated logout: when true, POST /auth/logout also redirects the browser through the
# IdP end_session_endpoint to clear the IdP session. Off by default.
AUTH_RP_LOGOUT=false
# Where the IdP returns the browser after RP-initiated logout (must be pre-registered at the IdP).
# AUTH_POST_LOGOUT_REDIRECT=http://localhost:3000/

# CSRF Origin allowlist (comma-separated) for mutating requests. Defaults to the local SPA dev
# origin; set to the real app origin(s) in production. An empty value disables the CSRF guard.
AUTH_ALLOWED_ORIGINS=http://localhost:3000
