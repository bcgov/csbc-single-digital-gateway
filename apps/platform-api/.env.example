# platform-api environment
# Copy to .env (gitignored). Validated by zod at boot — see src/config/env.schema.ts.
#
# The values below are LOCAL-DEV defaults that work against the root compose.yml stack
# (Postgres + Valkey + Keycloak with the committed keycloak/sdg-realm.json). They are NOT
# secrets and MUST be replaced for any non-local environment.

# Node environment: development | production | test
NODE_ENV=development

# HTTP port the server listens on
PORT=4001

# pino log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# --- Database (required, no default) -----------------------------------------------------------
# Matches compose.yml (user/pass/db = postgres/postgres/sdg). If 5432 is taken, start Postgres
# with POSTGRES_PORT=<port> and change the port here to match.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sdg

# --- OIDC / BFF (required, no default) ----------------------------------------------------------
# Local Keycloak realm "sdg" + confidential client "platform-api" (see keycloak/sdg-realm.json).
OIDC_ISSUER=http://localhost:8080/realms/sdg
OIDC_CLIENT_ID=platform-api
OIDC_CLIENT_SECRET=test-secret
OIDC_REDIRECT_URI=http://localhost:4001/auth/callback
# Session cookie signing secret (min 16 chars). Use a long random value in production.
AUTH_SESSION_SECRET=dev-session-secret-change-me
# Where the app sends the browser after a successful login (platform-web runs on :3001).
AUTH_POST_LOGIN_REDIRECT=http://localhost:3001
# Baseline role stamped on a user's first login (user_role: admin | staff | citizen).
AUTH_DEFAULT_ROLE=staff
# Valkey key prefix for this app's sessions (MUST be unique per app sharing a Valkey).
SESSION_KEY_PREFIX=sdg:

# --- Logout hardening ---------------------------------------------------------------------------
# RP-initiated logout: when true, POST /auth/logout also redirects the browser through the IdP
# end_session_endpoint to clear the IdP session. Off by default.
AUTH_RP_LOGOUT=false
# Where the IdP returns the browser after RP-initiated logout (must be pre-registered at the IdP).
# AUTH_POST_LOGOUT_REDIRECT=http://localhost:3000/

# --- CSRF -------------------------------------------------------------------------------------
# Refresh the access token this many seconds before it expires (lazy, on-request). Default 30.
AUTH_TOKEN_REFRESH_SKEW_SECONDS=30

# CSRF Origin allowlist (comma-separated) for mutating requests. platform-web runs on :3001.
# Set to the real app origin(s) in production. An empty value disables the CSRF guard.
AUTH_ALLOWED_ORIGINS=http://localhost:3001

# --- Session store ------------------------------------------------------------------------------
# Valkey (Redis wire protocol); defaults to the local compose service on 6380.
VALKEY_URL=redis://localhost:6380
