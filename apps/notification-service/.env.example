# notification-service environment
# Copy to .env (gitignored). Validated by zod at boot — see src/config/env.schema.ts.
#
# Local-dev defaults against the root compose.yml stack (notifications-postgres on 5433).
# NOT secrets — replace for any non-local environment.

# Node environment: development | production | test
NODE_ENV=development

# HTTP port the server listens on
PORT=4002

# pino log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# --- Database (required, no default) -----------------------------------------------------------
# The notification-service's OWN database (@repo/notification-database) — a separate Postgres
# from @repo/database's. Matches compose.yml (postgres/postgres/sdg_notifications on 5433).
NOTIFICATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/sdg_notifications

# --- m2m auth (required, no default) ------------------------------------------------------------
# OIDC issuer whose client-credentials tokens are accepted — the Keycloak sdg realm, where the
# producer service-account clients live (platform-api-m2m, citizen-portal-api-m2m).
OIDC_ISSUER=http://localhost:8080/realms/sdg
# Audience every accepted token must carry (injected by the clients' audience mapper).
M2M_AUDIENCE=notification-service

# --- Database TLS (optional) --------------------------------------------------------------------
# PGSSLMODE = disable | no-verify | verify-ca | verify-full; NOTIFICATION_DATABASE_CA_CERT is the
# CA PEM used to verify the server. Unset → no TLS (local dev).
# PGSSLMODE=verify-full
# NOTIFICATION_DATABASE_CA_CERT=
