{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "coverage/**",
    ".turbo/**",
    "**/routeTree.gen.ts"
  ],
  "rules": {
    "no-extraneous-class": ["warn", { "allowWithDecorator": true }],
    "no-underscore-dangle": ["warn", { "allow": ["__APP_CONFIG__"] }]
  },
  "overrides": [
    {
      "files": ["packages/ui/src/components/ui/**/*.tsx"],
      "rules": {
        "no-shadow": "off",
        "no-underscore-dangle": "off"
      }
    }
  ]
}
