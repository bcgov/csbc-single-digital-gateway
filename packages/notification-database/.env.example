# @repo/notification-database environment
# Copy to .env (gitignored). Read by drizzle-kit (db:migrate, db:studio) and the migrate
# runner (db:migrate:run) to reach the notification Postgres. NOT a secret — this is the
# LOCAL-DEV default that matches the root compose.yml notifications-postgres service
# (user/pass/db = postgres/postgres/sdg_notifications on ${NOTIFICATIONS_POSTGRES_PORT:-5433}).
# Replace with a real connection string for any non-local environment.
NOTIFICATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/sdg_notifications
