{
  "name": "@repo/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "vite build",
    "build:scripts": "esbuild src/migrate.ts src/seed.ts --bundle --platform=node --format=esm --target=node24 --outdir=dist-scripts --packages=external",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:run": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "db:seed:geo": "tsx src/geo/import.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "vite build --watch",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "tsx": "^4.22.4",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2"
  }
}
