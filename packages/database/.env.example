# @repo/database environment
# Copy to .env (gitignored). Read by drizzle-kit (db:migrate, db:studio) and the seed
# script (db:seed) to reach Postgres. NOT a secret — this is the LOCAL-DEV default that
# matches the root compose.yml Postgres service (user/pass/db = postgres/postgres/sdg on
# ${POSTGRES_PORT:-5432}). Replace with a real connection string for any non-local environment.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sdg
