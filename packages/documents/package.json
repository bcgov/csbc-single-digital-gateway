{
  "name": "@repo/documents",
  "version": "0.0.0",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    "./studio": {
      "types": "./dist/studio.d.ts",
      "development": "./src/studio.ts",
      "import": "./dist/studio.js",
      "require": "./dist/studio.cjs"
    },
    "./styles.css": {
      "development": "./src/styles.css",
      "default": "./dist/styles.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mdi/js": "7.4.47",
    "@mdi/react": "1.6.1",
    "@repo/forms": "*",
    "@repo/ui": "*",
    "@xyflow/react": "12.11.3",
    "nanoid": "^3.3.17"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "29.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vite": "8.0.16",
    "vite-plugin-dts": "5.0.2"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  }
}
