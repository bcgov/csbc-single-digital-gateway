{
  "name": "@repo/react",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./notification-center": {
      "types": "./dist/notification-center.d.ts",
      "development": "./src/notification-center.ts",
      "import": "./dist/notification-center.js",
      "require": "./dist/notification-center.cjs"
    },
    "./shared-event-stream": {
      "types": "./dist/shared-event-stream.d.ts",
      "development": "./src/shared-event-stream.ts",
      "import": "./dist/shared-event-stream.js",
      "require": "./dist/shared-event-stream.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "gen:entries": "node scripts/gen-entries.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "@repo/ui": "*"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "29.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vite": "8.0.16",
    "vite-plugin-dts": "5.0.2"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  }
}
