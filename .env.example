# Environment variables for single-digital-gateway
# Copy this file to .env and fill in real values. .env is gitignored.

# PostgreSQL connection string used by @repo/database (drizzle-kit migrate/seed and the
# createDatabase() client). Matches the local Compose Postgres service (compose.yml).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sdg

# OIDC (BFF auth) — matches the local Compose Keycloak realm (keycloak/sdg-realm.json).
OIDC_ISSUER=http://localhost:8080/realms/sdg
OIDC_CLIENT_ID=platform-api
OIDC_CLIENT_SECRET=test-secret
OIDC_REDIRECT_URI=http://localhost:4001/auth/callback
# Session signing secret (>= 16 chars). Generate a strong value for real environments.
AUTH_SESSION_SECRET=local-dev-session-secret-change-me
# Where /auth/callback sends the browser after a successful login.
AUTH_POST_LOGIN_REDIRECT=http://localhost:3000/app
# Session store (Valkey, Redis wire protocol) — matches the Compose valkey service.
VALKEY_URL=redis://localhost:6380
